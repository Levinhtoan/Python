PROJECT_NAME="Booking & Scheduling Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Storage Selection: "postgres" hoặc "json"
DB_TYPE="postgres"

# Cấu hình khi DB_TYPE="json"
DATA_FILE_PATH="data/bookings.json"

# Cấu hình khi DB_TYPE="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="123456"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="booking_db"
DATABASE_URL="postgresql://postgres:123456@localhost:5432/booking_db"

